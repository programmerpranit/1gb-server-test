# Copy to .env and fill in. .env is git-ignored.

# Droplet under test. Scripts SSH in with key auth (no password prompts) and need root
# (apt, systemctl, /proc/sys/vm/drop_caches). Keep SERVER_USER=root unless you change that.
SERVER_HOST=203.0.113.10
SERVER_USER=root
# Private key for the droplet (optional if your default key/agent works)
SSH_KEY=~/.ssh/do
# Load generator droplet (same region + VPC as the target). k6 runs here; scripts drive it over SSH from the Mac.
# Recreated each session: only LOADGEN_HOST changes. Set up with scripts/provision_loadgen.sh.
LOADGEN_HOST=203.0.113.20
# IP k6 sends traffic to: the target's private VPC IP
TARGET_HOST=10.122.0.2
# Live k6 dashboard is tunnelled to http://localhost:$DASHBOARD_PORT during runs
DASHBOARD_PORT=5665

# Port the app listens on (every app in apps/ must honour $PORT)
APP_PORT=3000

# Postgres role/password used by the app (created by scripts/provision.sh)
DB_USER=bench
DB_PASSWORD=change-me   # letters/digits only (passed through ssh/psql unquoted)

# Where the load is generated from. Recorded in every result.
# e.g. "do-blr1-loadgen-4vcpu-8gb" (change it when the load generator size changes)
LOADGEN_LABEL=do-blr1-loadgen-4vcpu-8gb

# Only for `run_test.sh --search`: VU ladder to climb (manual runs take VU levels as arguments)
VU_LADDER="100 250 500 1000 2000"

# Pass criteria for one run (steady-phase latency, whole-run errors). A level passes only if all hold.
PASS_P50_MS=500
PASS_P95_MS=800
PASS_P99_MS=1000
PASS_ERROR_PCT=1
# Only for `run_test.sh --search`: bisection resolution (VUs) between the last pass and the first fail
SEARCH_STEP=10
